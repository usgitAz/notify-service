#App
DEBUG=true
APP_NAME="Notification Service"
APP_DESCRIPTION="super fast, fully non-blocking notification as a service - Nass"
APP_VERSION= "0.1.0"

# Database
POSTGRES_USER=notify_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=notify_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Logging
LOG_SAMPLE_RATE=1.0

#uvicorn
HOST="0.0.0.0"
UVICORN_PORT=8000
UVICORN_WORKERS=4

# Security
# Pepper for HMAC-SHA256 hashing of API keys.
# MUST be at least 48 chars, kept secret, never committed.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER="change-me-in-production-with-a-random-48+-char-string"


# Email (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="Notification Service"
SMTP_USE_TLS=true
